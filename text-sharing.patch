diff --git a/app/src/main/java/com/lanshare/app/core/Notes.kt b/app/src/main/java/com/lanshare/app/core/Notes.kt
new file mode 100644
index 0000000..59169e3
--- /dev/null
+++ b/app/src/main/java/com/lanshare/app/core/Notes.kt
@@ -0,0 +1,90 @@
+package com.lanshare.app.core
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * Text inbox: every text / link sent to or received from another device, oldest first.
+ * Persisted in <filesDir>/inbox.json (written to a temp file, then renamed), capped by count and total size.
+ */
+object Notes {
+    class Note(val id: Long, val ts: Long, val out: Boolean, val peer: String, val text: String)
+
+    private const val MAX_ITEMS = 300
+    private const val MAX_TEXT = 100_000
+    private const val MAX_TOTAL = 2_000_000
+    private val items = ArrayList<Note>()
+    private var loaded = false
+    private var nextId = 1L
+
+    /** Called (on any thread) after the list changed. */
+    val listeners = CopyOnWriteArrayList<() -> Unit>()
+    /** The inbox screen is on top: an incoming text needs no heads-up notification. */
+    @Volatile var visible = false
+
+    private fun file(): File? = Cfg.dir?.let { File(it, "inbox.json") }
+
+    private fun ensure() {
+        if (loaded) return
+        val f = file() ?: return   // config not loaded yet: try again on the next call
+        loaded = true
+        try {
+            if (f.isFile) {
+                val a = JSONArray(f.readText())
+                for (i in 0 until a.length()) {
+                    val o = a.optJSONObject(i) ?: continue
+                    val id = o.optLong("id", nextId)
+                    items.add(Note(id, o.optLong("ts"), o.optBoolean("out"), o.optString("peer"), o.optString("text")))
+                    if (id >= nextId) nextId = id + 1
+                }
+            }
+        } catch (_: Exception) {}
+    }
+
+    private fun save() {
+        val f = file() ?: return
+        try {
+            val a = JSONArray()
+            for (n in items) a.put(JSONObject().put("id", n.id).put("ts", n.ts).put("out", n.out).put("peer", n.peer).put("text", n.text))
+            val tmp = File(f.path + ".tmp")
+            tmp.writeText(a.toString())
+            if (!tmp.renameTo(f)) { f.delete(); if (!tmp.renameTo(f)) f.writeText(a.toString()) }
+        } catch (_: Exception) {}
+    }
+
+    private fun fire() { for (l in listeners) try { l() } catch (_: Throwable) {} }
+
+    /** Adds one entry ([out] = sent by this device). The same text twice within 2 s from the same device is kept once. */
+    fun add(out: Boolean, peer: String, text: String): Note? {
+        if (text.isBlank()) return null
+        val t = text.take(MAX_TEXT)
+        val n: Note
+        synchronized(this) {
+            ensure()
+            val now = System.currentTimeMillis()
+            val last = items.lastOrNull()
+            if (last != null && last.out == out && last.peer == peer && last.text == t && now - last.ts < 2000) return last
+            n = Note(nextId++, now, out, peer, t)
+            items.add(n)
+            var total = items.sumOf { it.text.length }
+            while (items.size > MAX_ITEMS || (total > MAX_TOTAL && items.size > 1)) { total -= items.removeAt(0).text.length }
+            save()
+        }
+        fire()
+        return n
+    }
+
+    @Synchronized fun all(): List<Note> { ensure(); return ArrayList(items) }
+
+    fun remove(id: Long) {
+        synchronized(this) { ensure(); if (!items.removeAll { it.id == id }) return; save() }
+        fire()
+    }
+
+    fun clear() {
+        synchronized(this) { ensure(); items.clear(); save() }
+        fire()
+    }
+}
diff --git a/app/src/main/java/com/lanshare/app/core/PcText.kt b/app/src/main/java/com/lanshare/app/core/PcText.kt
new file mode 100644
index 0000000..cc30c63
--- /dev/null
+++ b/app/src/main/java/com/lanshare/app/core/PcText.kt
@@ -0,0 +1,70 @@
+package com.lanshare.app.core
+
+import org.json.JSONObject
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * PCs that run pcprint.py v26+ also receive text: its print port (8799) answers `/p/clip` like a phone does. They are not LANShare peers (no
+ * beacons, no file access), so they are found here: every ~30 s (on demand, see [kick]) the addresses we already know - other devices, saved
+ * SMB hosts, pinned hosts, ARP neighbours - are asked `GET /ping`, and a reply with `"clip": true` makes that host a text target.
+ * They appear next to the phones as "<PC name> (PC)" with the id "pc:<ip>" (usable as the default device, in Direct Share, the tile ...).
+ */
+object PcText {
+    const val PREFIX = "pc:"
+    private const val TTL = 100_000L
+    private class Pc(val ip: String, val name: String, val seen: Long)
+    private val pcs = ConcurrentHashMap<String, Pc>()
+    private val busy = AtomicBoolean(false)
+    @Volatile private var lastScan = 0L
+
+    private fun peerOf(p: Pc) = Peer(PREFIX + p.ip, p.ip, Jobs.PRINT_PORT, p.name + " (PC)", p.seen, listOf(p.ip), true)
+
+    /** PCs that answered within the last 100 s. */
+    fun peers(): List<Peer> {
+        val now = System.currentTimeMillis()
+        return pcs.values.filter { now - it.seen < TTL }.sortedBy { it.name.lowercase() }.map { peerOf(it) }
+    }
+
+    /** A PC by its "pc:<ip>" id (also when it was last seen a while ago: the send itself tells whether it is still there). */
+    fun get(id: String): Peer? = if (id.startsWith(PREFIX)) pcs[id.removePrefix(PREFIX)]?.let { peerOf(it) } else null
+
+    /** Starts a background look-around unless one ran in the last 30 s. Cheap to call often. */
+    fun kick() {
+        val now = System.currentTimeMillis()
+        if (now - lastScan < 30_000 || !busy.compareAndSet(false, true)) return
+        lastScan = now
+        Thread { try { scan() } catch (_: Throwable) {} finally { busy.set(false) } }.also { it.isDaemon = true }.start()
+    }
+
+    private fun scan() {
+        val ips = LinkedHashSet<String>()
+        ips.addAll(pcs.keys)
+        val d = Core.discOrNull()
+        if (d != null) for (p in d.list()) { ips.add(p.ip); ips.addAll(p.ips) }
+        try { val a = Cfg.smb(); for (k in 0 until a.length()) a.optJSONObject(k)?.optString("host")?.takeIf { it.isNotEmpty() }?.let { ips.add(Smb.split(it).first) } } catch (_: Exception) {}
+        try { ips.addAll(Cfg.pins()) } catch (_: Exception) {}
+        try { ips.addAll(Net.arpNeighbors()) } catch (_: Exception) {}
+        d?.ownIps?.let { ips.removeAll(it) }
+        ips.removeAll { it.isBlank() }
+        val pool = Executors.newFixedThreadPool(16) { r -> Thread(r).also { it.isDaemon = true } }
+        try {
+            for (ip in ips.take(120)) pool.execute {
+                try {
+                    val r = Http.request(ip, Jobs.PRINT_PORT, "GET", "/ping", emptyMap(), 1500)
+                    try {
+                        if (r.status == 200) {
+                            val o = JSONObject(String(r.readUpTo(32768), Charsets.UTF_8))
+                            if (o.optBoolean("clip", false)) pcs[ip] = Pc(ip, o.optString("name").ifBlank { ip }, System.currentTimeMillis())
+                        }
+                    } finally { r.close() }
+                } catch (_: Exception) {}
+            }
+        } finally {
+            pool.shutdown()
+            try { pool.awaitTermination(8, TimeUnit.SECONDS) } catch (_: InterruptedException) {}
+        }
+    }
+}
