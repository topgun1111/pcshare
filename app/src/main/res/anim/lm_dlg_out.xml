<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen M1: dialog exit = 140 ms (exit factor 0.7 x t.base), accelerate, fade + scale to 0.92 -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:anim/accelerate_interpolator">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="140"/>
    <scale android:fromXScale="1" android:toXScale="0.92" android:fromYScale="1" android:toYScale="0.92"
        android:pivotX="50%" android:pivotY="50%" android:duration="140"/>
</set>
