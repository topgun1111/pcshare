<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen M7: return from a viewer: fade + scale 100 % to 94 %, 200 ms accelerate -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:anim/accelerate_interpolator">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="200"/>
    <scale android:fromXScale="1" android:toXScale="0.94" android:fromYScale="1" android:toYScale="0.94" android:pivotX="50%" android:pivotY="50%" android:duration="200"/>
</set>
