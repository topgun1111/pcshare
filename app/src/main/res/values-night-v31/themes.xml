<resources>
    <!-- night variant of Theme.LANShare (Android 12+): dark splash screen on the dark canvas, light bar icons off -->
    <style name="Theme.LANShare" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:alertDialogTheme">@style/Theme.LANShare.Dialog</item>
        <item name="android:windowSplashScreenBackground">@color/canvas</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
