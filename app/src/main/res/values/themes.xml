<resources>
    <style name="Theme.LANShare" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:alertDialogTheme">@style/Theme.LANShare.Dialog</item>
    </style>
    <style name="Theme.LANShare.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:alertDialogTheme">@style/Theme.LANShare.Dialog.Dark</item>
    </style>
    <!-- invisible one-shot activities (ClipSendActivity): no window of their own, only a toast / a picker dialog -->
    <style name="Theme.LANShare.Clear" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
    <!-- uniform AlertDialog: 28 dp corners, same width everywhere (90 % of a portrait screen, 400 dp otherwise) -->
    <style name="Theme.LANShare.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dlg_bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
    <style name="Theme.LANShare.Dialog.Dark" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dlg_bg_dark</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
